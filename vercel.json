{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-continent", "value": "AF" }],
      "destination": "https://webinar-dashboard-psi.vercel.app/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "GB" }],
      "destination": "https://webinar-dashboard-psi.vercel.app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sites/dataverse/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=31536000, immutable" }
      ]
    }
  ]
}
